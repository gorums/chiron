# Copy this file to `.env` (same folder) before `docker compose up`.
# `.env` is gitignored; this example is not.

# Where Claude Code keeps its OAuth tokens on the host. The container mounts this so it can
# use your subscription instead of an API key.
#
#   Windows   CLAUDE_HOME=C:/Users/<you>/.claude
#   macOS     CLAUDE_HOME=/Users/<you>/.claude
#   Linux     CLAUDE_HOME=/home/<you>/.claude
#
# Use forward slashes on Windows. Do not quote the value.
CLAUDE_HOME=C:/Users/ackse/.claude

# Where the courses are. Each course is its own repository, cloned into this directory; the
# platform only lists what it finds there. Default: ./courses (gitignored in this repo).
# Relative paths are taken from the platform folder. Forward slashes on Windows.
#
#   COURSES_DIR=../courses
#   COURSES_DIR=D:/Courses
#COURSES_DIR=./courses

# Where builds go. Default: ./dist (gitignored). Point it inside a course repository if you
# want to commit the built HTML - e.g. to publish it with GitHub Pages.
#DIST_DIR=./dist

# ---- Everything below overrides a value in platform/settings.json, the one file that holds
# every default of the platform (ports, the providers, the model list, timeouts, the page's
# study rules). Leave a line commented to keep the default. A change needs a restart of
# Studio / the bridge; `python platform/build.py where` shows what is in force.

# Studio: where it listens. Keep the host on loopback - Studio writes files and spawns
# processes. Compose reads STUDIO_PORT too, so the published port always matches.
#STUDIO_HOST=127.0.0.1
#STUDIO_PORT=8790

# The bridge (the tutor for a course page opened off disk). BRIDGE_URL is what a built page
# tries first; leave it unset to derive it from the host and port.
#BRIDGE_HOST=127.0.0.1
#BRIDGE_PORT=8787
#BRIDGE_URL=http://127.0.0.1:8787

# Jupyter: the server that runs a course's notebooks inside the course page. Compose reads
# JUPYTER_PORT and JUPYTER_TOKEN too, so the published port and the server's always agree.
# Change the token if anything else on this machine could reach the port. JUPYTER_URL is
# what the course page opens; JUPYTER_INTERNAL_URL is where Studio looks for the server
# (compose sets it to the service name; leave it unset otherwise).
#JUPYTER_HOST=127.0.0.1
#JUPYTER_PORT=8888
#JUPYTER_TOKEN=course-platform
#JUPYTER_URL=http://127.0.0.1:8888
#JUPYTER_INTERNAL_URL=http://127.0.0.1:8888

# The model every generation and tutor call asks for, unless Studio's Settings page or the
# request says otherwise. An alias or full id from the model list (Settings & logs in Studio).
#STUDIO_MODEL=sonnet

# ---- Providers: how a model is reached. `providers` in platform/settings.json holds one row
# per way in - a signed-in CLI, or an endpoint that takes a key - and every model in the list
# names the row that reaches it. The keys below fill in the row named after them; a provider
# with no key configured is simply not offered. A key is never shown on the settings page and
# never reaches a course page, which asks the reader for their own.
#
# Anthropic. Also what Studio reads GET /v1/models with, to keep the model list current.
#ANTHROPIC_API_KEY=
#ANTHROPIC_API_VERSION=2023-06-01
#BRIDGE_API_URL=https://api.anthropic.com/v1/messages

# The other two cloud providers. Enable their row in settings.json (or an overlay) to offer
# them; without a key they stay off.
#OPENAI_API_KEY=
#GOOGLE_API_KEY=

# Which provider a model that names none belongs to.
#LLM_DEFAULT_PROVIDER=claude-code

# DEBUG adds one access line per request to state/logs/studio.log.
#STUDIO_LOG_LEVEL=INFO

# Where Studio keeps reader progress, finished jobs, the trash and the log. Default: ./state
#STUDIO_STATE_ROOT=./state
#STUDIO_STATE_DIR=./state/progress

# A JSON file deep-merged over platform/settings.json - for anything without a name above,
# such as a different model list or longer timeouts, without editing the committed file.
#SETTINGS_FILE=./settings.local.json
