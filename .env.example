# Copy this file to `.env` (same folder) before `docker compose up`.
# `.env` is gitignored; this example is not.

# Where Claude Code keeps its OAuth tokens on the host. The container mounts this so it can
# use your subscription instead of an API key.
#
#   Windows   CLAUDE_HOME=C:/Users/<you>/.claude
#   macOS     CLAUDE_HOME=/Users/<you>/.claude
#   Linux     CLAUDE_HOME=/home/<you>/.claude
#
# Use forward slashes on Windows. Do not quote the value.
CLAUDE_HOME=C:/Users/ackse/.claude

# Where the courses are. Each course is its own repository, cloned into this directory; the
# platform only lists what it finds there. Default: ./courses (gitignored in this repo).
# Relative paths are taken from the platform folder. Forward slashes on Windows.
#
#   COURSES_DIR=../courses
#   COURSES_DIR=D:/Courses
#COURSES_DIR=./courses

# Where builds go. Default: ./dist (gitignored). Point it inside a course repository if you
# want to commit the built HTML - e.g. to publish it with GitHub Pages.
#DIST_DIR=./dist
